+/* --------------------------------------------------------------------------
+   13. CORNER LAMP
+   A little hand-drawn desk lamp, stuck in the bottom-right corner like a
+   sticker. Purely decorative for now (it just flickers when clicked) — the
+   plan is to wire it up to a real dark-mode toggle later; see the click
+   handler in script.js for where that would hook in.
+   -------------------------------------------------------------------------- */
+.corner-lamp {
+  position: fixed;
+  right: 1.25rem;
+  bottom: 1.25rem;
+  z-index: 100;
+  width: 4.25rem;
+  height: 5.75rem;
+  padding: 0;
+  border: 0;
+  background: none;
+  color: var(--brown-soft);
+  cursor: pointer;
+  filter: drop-shadow(0 8px 14px rgba(74, 47, 37, 0.22));
+  transition: transform 0.25s ease, color 0.25s ease;
+}
+
+.corner-lamp:hover,
+.corner-lamp:focus-visible {
+  transform: translateY(-3px) rotate(-3deg);
+  color: var(--brown);
+}
+
+.corner-lamp__art {
+  width: 100%;
+  height: 100%;
+  overflow: visible;
+}
+
+.corner-lamp__line,
+.corner-lamp__cord {
+  fill: none;
+  stroke: currentColor;
+  stroke-width: 4;
+  stroke-linecap: round;
+  stroke-linejoin: round;
+}
+
+.corner-lamp__knot {
+  fill: currentColor;
+}
+
+.corner-lamp__glow {
+  fill: var(--chartreuse-pale);
+  opacity: 0.45;
+  animation: lamp-glow 3.4s ease-in-out infinite;
+}
+
+@keyframes lamp-glow {
+  0%, 100% { opacity: 0.3; }
+  50% { opacity: 0.65; }
+}
+
+.corner-lamp--flicker .corner-lamp__glow {
+  animation: lamp-flicker 0.4s steps(2, end) 3;
+}
+
+@keyframes lamp-flicker {
+  0%, 100% { opacity: 0.65; }
+  50% { opacity: 0.1; }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .corner-lamp__glow {
+    animation: none;
+    opacity: 0.5;
+  }
+}
+
+@media (max-width: 480px) {
+  .corner-lamp {
+    right: 0.75rem;
+    bottom: 0.75rem;
+    width: 3.25rem;
+    height: 4.5rem;
   }
 }
